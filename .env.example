# Copy to .env. Not required to run locally with dummy data - only needed
# once this connects to real DynamoDB tables and Cognito.

PORT=3000

# Comma-separated list of origins allowed to call this API (your frontend's
# dev server and, later, its S3/CloudFront URL)
CORS_ORIGIN=http://localhost:5173

# Filled in once the real DynamoDB tables exist (see src/common/data/*)
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_PREFIX=MediConnect_

# Filled in once Cognito exists, so RolesGuard can verify a real JWT
# instead of the dummy x-user-role header
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
